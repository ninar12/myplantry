# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local MCP server config (contains access tokens)
.mcp.json
/scripts/data/*

# local Claude Code session state
/.claude/

# local Supabase CLI state
/supabase/.temp/

# emoji assets (served from Supabase Storage)
/public/emojis/
# typescript
*.tsbuildinfo
next-env.d.ts
